<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your Orders - Sail.in</title>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; margin: 0; padding: 20px; background-color: #f0f0f0; color: #333; }
        h1 { text-align: center; color: #000; margin-bottom: 40px; font-size: 2.5rem; }
        .order-list { display: flex; flex-direction: column; gap: 25px; max-width: 900px; margin: 0 auto; }
        .order-item { background-color: #ffffff; padding: 20px; border-radius: 10px; box-shadow: 0 4px 10px rgba(0,0,0,0.1); }
        .order-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 15px; border-bottom: 1px solid #eee; padding-bottom: 10px; }
        .order-details-left p, .order-details-right p { margin: 5px 0; font-size: 0.95rem; }
        .order-details-left p strong, .order-details-right p strong { color: #000; }
        .status-badge { padding: 5px 10px; border-radius: 20px; font-size: 0.85rem; font-weight: bold; }
        .status-Placed { background-color: #cce5ff; color: #004085; }
        .status-Packed { background-color: #fff3cd; color: #856404; }
        .status-Shipped { background-color: #d1ecf1; color: #0c5460; }
        .status-Delivered { background-color: #d4edda; color: #155724; }
        .status-Cancelled { background-color: #f8d7da; color: #721c24; }
    </style>
</head>
<body>
    <%- include('header') %>
    <h1>Your Orders</h1>
    <div class="order-list">
        <% if (orders && orders.length > 0) { %>
            <% orders.forEach(order => { %>
                <div class="order-item">
                    <div class="order-header">
                        <div class="order-details-left">
                            <p><strong>Order ID:</strong> #<%= order.orderId %></p>
                            <p><strong>Date:</strong> <%= new Date(order.orderDate).toLocaleDateString() %></p>
                            <p><strong>Total Amount:</strong> ₹<%= order.totalCost %></p>
                            <p><strong>Items Count:</strong> <%= order.orderItems %></p>
                        </div>
                        <div class="order-details-right">
                            <p><strong>Status:</strong> <span class="status-badge status-<%= order.status %>"><%= order.status %></span></p>
                            <% if (order.status === 'Placed' || order.status === 'Packed') { %>
                                <form action="/orders/<%= order.orderId %>/cancel" method="POST" style="margin-top: 15px; text-align: right;">
                                    <button type="submit" style="padding: 6px 12px; background-color: #dc3545; color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 0.9rem;">Cancel Order</button>
                                </form>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% }); %>
        <% } else { %>
            <div style="text-align:center;">
                <h2>No orders found.</h2>
                <a href="/" style="padding: 10px 20px; background-color: #007bff; color: white; text-decoration: none; border-radius: 5px;">Start Shopping</a>
            </div>
        <% } %>
    </div>
    <%- include('footer') %>
</body>
</html>
