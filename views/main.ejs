<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sail.in</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400&display=swap">
    <link rel="stylesheet" href="main.css">
</head>
<body>
  <%- include('header.ejs') %> 
    <div class="marquee">
        <div class="marquee-track">
          <span>NEW ARRIVALS • EXCLUSIVE OFFERS • LIMITED TIME DEALS • FREE SHIPPING •</span>
          <span>GET 50% OFF ON SELECT ITEMS • DON'T MISS OUT • SHOP NOW •</span>
          <span>NEW SEASON • LIMITED EDITION • FREE SHIPPING • EXCLUSIVE DEALS •</span>
          <span>SHOP OUR BESTSELLERS • HURRY, WHILE STOCKS LAST •</span>
        </div>
      </div>
    
      <!-- Large Banner Image -->
      <div class="banner">
        <img src="/images/WdkUt9x6Q3CodtE672_lpQ.webp" alt="Banner Image">
      </div>
    

      <!-- Product Section: MEN'S SHIRTS -->
      <div class="product-section">
        <div class="product-header">
          <h2 class="product-title">MEN'S SHIRTS</h2>
          <div class="nav-btns">
            <button class="nav-btn prev-btn"><i class="fas fa-chevron-left"></i></button>
            <button class="nav-btn next-btn"><i class="fas fa-chevron-right"></i></button>
          </div>
        </div>
        <div class="product-container" id="productContainer1">
          <% if(typeof products !== 'undefined' && products.length > 0) { %>
            <% products.slice(5, 10).forEach(product => { %>
              <div class="product-item">
                <a href="/product/<%= product.p_id %>">
                  <img src="images/pd<%= product.p_id %>pic1.jpg" onerror="this.src='/images/pd<%= product.p_id %>img1.jpg'" height="400px" width="300px" alt="<%= product.p_name %>">
                </a>
                <div class="product-info">
                  <h2><%= product.p_name %></h2>
                  <p>₹<%= product.p_price %></p>
                </div>
              </div>
            <% }) %>
          <% } %>
        </div>
      </div>

      <!-- Product Section: MEN'S PANTS -->
      <div class="product-section">
        <div class="product-header">
          <h2 class="product-title">MEN'S PANTS</h2>
          <div class="nav-btns">
            <button class="nav-btn prev-btn"><i class="fas fa-chevron-left"></i></button>
            <button class="nav-btn next-btn"><i class="fas fa-chevron-right"></i></button>
          </div>
        </div>
        <div class="product-container" id="productContainer2">
          <% if(typeof products !== 'undefined' && products.length > 0) { %>
            <% products.slice(0, 5).forEach(product => { %>
              <div class="product-item">
                <a href="/product/<%= product.p_id %>">
                  <img src="images/pd<%= product.p_id %>pic1.jpg" onerror="this.src='/images/pd<%= product.p_id %>img1.jpg'" height="400px" width="300px" alt="<%= product.p_name %>">
                </a>
                <div class="product-info">
                  <h2><%= product.p_name %></h2>
                  <p>₹<%= product.p_price %></p>
                </div>
              </div>
            <% }) %>
          <% } %>
        </div>
      </div>

      <!-- Product Section: MEN'S T-SHIRTS -->
      <div class="product-section">
        <div class="product-header">
          <h2 class="product-title">MEN'S T-SHIRTS</h2>
          <div class="nav-btns">
            <button class="nav-btn prev-btn"><i class="fas fa-chevron-left"></i></button>
            <button class="nav-btn next-btn"><i class="fas fa-chevron-right"></i></button>
          </div>
        </div>
        <div class="product-container" id="productContainer3">
          <% if(typeof products !== 'undefined' && products.length > 0) { %>
            <% products.slice(25, 30).forEach(product => { %>
              <div class="product-item">
                <a href="/product/<%= product.p_id %>">
                  <img src="images/pd<%= product.p_id %>img1.jpg" onerror="this.src='/images/pd<%= product.p_id %>pic1.jpg'" height="400px" width="300px" alt="<%= product.p_name %>">
                </a>
                <div class="product-info">
                  <h2><%= product.p_name %></h2>
                  <p>₹<%= product.p_price %></p>
                </div>
              </div>
            <% }) %>
          <% } %>
        </div>
      </div>

      <!-- Modal Structure -->  
      <div class="banner">
        <img src="/images/f1epgGB4S8u5tH7Fi2uJHA.webp" alt="Banner Image">
      </div>

      <!-- Product Section: MEN'S WATCHES -->
      <div class="product-section">
        <div class="product-header">
          <h2 class="product-title">MEN'S WATCHES</h2>
          <div class="nav-btns">
            <button class="nav-btn prev-btn"><i class="fas fa-chevron-left"></i></button>
            <button class="nav-btn next-btn"><i class="fas fa-chevron-right"></i></button>
          </div>
        </div>
        <div class="product-container" id="productContainer4">
          <% if(typeof products !== 'undefined' && products.length > 0) { %>
            <% products.slice(10, 15).forEach(product => { %>
              <div class="product-item">
                <a href="/product/<%= product.p_id %>">
                  <img src="images/pd<%= product.p_id %>pic1.jpg" onerror="this.src='/images/pd<%= product.p_id %>img1.jpg'" height="400px" width="300px" alt="<%= product.p_name %>">
                </a>
                <div class="product-info">
                  <h2><%= product.p_name %></h2>
                  <p>₹<%= product.p_price %></p>
                </div>
              </div>
            <% }) %>
          <% } %>
        </div>
      </div>

      <!-- Product Section: MEN'S NIGHT PANTS -->
      <div class="product-section">
        <div class="product-header">
          <h2 class="product-title">MEN'S NIGHT PANTS</h2>
          <div class="nav-btns">
            <button class="nav-btn prev-btn"><i class="fas fa-chevron-left"></i></button>
            <button class="nav-btn next-btn"><i class="fas fa-chevron-right"></i></button>
          </div>
        </div>
        <div class="product-container" id="productContainer5">
          <% if(typeof products !== 'undefined' && products.length > 0) { %>
            <% products.slice(15, 20).forEach(product => { %>
              <div class="product-item">
                <a href="/product/<%= product.p_id %>">
                  <img src="images/pd<%= (product.p_id - 15) %>img1.jpg" onerror="this.src='/images/pd<%= product.p_id %>img1.jpg'" height="400px" width="300px" alt="<%= product.p_name %>">
                </a>
                <div class="product-info">
                  <h2><%= product.p_name %></h2>
                  <p>₹<%= product.p_price %></p>
                </div>
              </div>
            <% }) %>
          <% } %>
        </div>
      </div>

      <!-- Product Section: MEN'S SHORTS -->
      <div class="product-section">
        <div class="product-header">
          <h2 class="product-title">MEN'S SHORTS</h2>
          <div class="nav-btns">
            <button class="nav-btn prev-btn"><i class="fas fa-chevron-left"></i></button>
            <button class="nav-btn next-btn"><i class="fas fa-chevron-right"></i></button>
          </div>
        </div>
        <div class="product-container" id="productContainer6">
          <% if(typeof products !== 'undefined' && products.length > 0) { %>
            <% products.slice(20, 25).forEach(product => { %>
              <div class="product-item">
                <a href="/product/<%= product.p_id %>">
                  <img src="images/pd<%= product.p_id !== 25 ? (product.p_id - 14) : 25 %>img1.jpg" onerror="this.src='/images/pd<%= product.p_id %>pic1.jpg'" height="400px" width="300px" alt="<%= product.p_name %>">
                </a>
                <div class="product-info">
                  <h2><%= product.p_name %></h2>
                  <p>₹<%= product.p_price %></p>
                </div>
              </div>
            <% }) %>
          <% } %>
        </div>
      </div>

<%- include('footer') %>
      <script src="main.js"></script>
</body>
</html>
