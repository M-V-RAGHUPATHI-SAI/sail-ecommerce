<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Footer</title>
    <style>
        footer {
            font-family: 'Montserrat', sans-serif;
            background-color: #f2f2f2; /* Keeps the footer light and neutral */
            color: #333;
        }

        .footer-section {
            background-color: rgb(41,83,174); /* Button color */
            padding: 40px 20px;
            color: white;
        }

        footer h3 {
            font-size: 18px;
            margin-bottom: 15px;
            color: white;
        }

        footer ul {
            list-style-type: none;
            padding: 0;
        }

        footer ul li {
            margin-bottom: 10px;
        }

        footer ul li a {
            color: white;
            text-decoration: none;
            font-size: 14px;
            transition: color 0.3s;
        }

        footer ul li a:hover {
            color: #ffcc00; /* Highlighted color for links on hover */
            text-decoration: underline;
        }

        .footer-section {
            display: flex;
            justify-content: space-around;
            flex-wrap: wrap;
        }

        .footer-section div {
            flex: 1;
            min-width: 200px;
            margin: 10px;
        }

        /* Style for copyright section */
        .footer-copyright {
            justify-content: center;
            text-align: center;
            padding-bottom: 5px;
            color: #333;
            background-color: #f2f2f2;
            font-size: 14px;
        }

        .payment-social {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px;
            background-color: #f2f2f2;
            border-top: 1px solid #ddd;
        }

        .payment-methods img, .social-icons img {
            width: 40px;
            height: 40px;
            margin-right: 15px;
            background-color: white; /* Add a white background to the icons */
            padding: 10px; /* Ensure the white background is visible */
            border-radius: 5px;
            box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
            transition: transform 0.3s, filter 0.3s;
        }

        .payment-methods img:hover, .social-icons img:hover {
            transform: scale(1.1);
            filter: grayscale(0);
        }

        @media (max-width: 768px) {
            .footer-section {
                flex-direction: column;
                align-items: center;
            }

            .payment-social {
                flex-direction: column;
                align-items: center;
            }

            .payment-methods {
                margin-bottom: 20px;
            }
        }
    </style>
</head>
<body>
    <footer>
        <div class="footer-section">
            <div>
                <h3>Help</h3>
                <ul>
                    <li><a href="help.html">FAQ</a></li>
                    <li><a href="/orders">Orders</a></li>
                    <li><a href="#">Delivery Information</a></li>
                    <li><a href="#">Returns Policy</a></li>
                    <li><a href="#">Make A Return</a></li>
                    <li><a href="#">Submit a Fake</a></li>
                </ul>
            </div>
            <div>
                <h3>My Account</h3>
                <ul>
                    <li><a href="/account.html">Login</a></li>
                    <li><a href="/account.html">Sign-up</a></li>
                </ul>
            </div>
            <div>
                <h3>Pages</h3>
                <ul>
                    <li><a href="about.html">About Us</a></li>
                    <li><a href="#">Careers</a></li>
                    <li><a href="#">Factory List</a></li>
                </ul>
            </div>
        </div>

        <div class="payment-social">
            <div class="payment-methods">
                <img src="images/visa.svg" alt="Visa">
                <img src="images/mastercard.svg" alt="Mastercard">
                <img src="images/upi.png" alt="UPI">
            </div>
            <div class="social-icons">
                <a href="#"><img src="images/facebook.jpg" alt="Facebook"></a>
                <a href="#"><img src="images/instagram.jpeg" alt="Instagram"></a>
                <a href="#"><img src="images/youtibe.jpeg" alt="YouTube"></a>
                <a href="#"><img src="images/twitter.png" alt="Twitter"></a>
                <a href="#"><img src="images/linkedin.jpg" alt="LinkedIn"></a>
            </div>
        </div>
        <div class="footer-copyright">
            <p>&copy; 2024 Sail. All rights reserved.</p>
        </div>
    </footer>
</body>
</html>
